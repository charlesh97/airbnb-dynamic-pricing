# iGMS Dynamic Pricing — Environment Configuration
# Copy this to .env and fill in values

# IGMS OAuth credentials
IGMS_CLIENT_ID=your_client_id_here
IGMS_CLIENT_SECRET=your_client_secret_here
IGMS_REDIRECT_URI=http://localhost:8080/callback
IGMS_SCOPE=listings,calendar-control,pricing-management

# Access token (from prior OAuth exchange)
IGMS_ACCESS_TOKEN=your_access_token_here

# Pricing engine config
# Comma-separated list: property_uid:base_price:min_price:max_price
# These are per-night base prices in USD unless currency is overridden
PROPERTY_CONFIGS=

# Strategy weights (default: demand,event,competitor,yield_)
STRATEGY_WEIGHTS=demand:0.40,event:0.30,competitor:0.20,yield:0.10

# How far ahead to price (days)
PRICING_WINDOW_DAYS=90

# How often to run (minutes)
SCHEDULE_INTERVAL_MINUTES=60

# External data (optional — competitor pricing)
COMPETITOR_API_KEY=

# Logging
LOG_LEVEL=INFO
